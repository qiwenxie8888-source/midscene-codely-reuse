# Copy this file to .env before running tests.
# Do not commit .env to your repository.
#
# 本项目用本机 Codely CLI（ACP 协议）当模型，不是 OpenAI 兼容 API。
# 三个值照抄下面即可，MIDSCENE_MODEL_API_KEY 留空（ACP 用 CLI 的登录态，不需要 key）：
#
#   MIDSCENE_MODEL_BASE_URL=codely://acp
#   MIDSCENE_MODEL_NAME=codely-vl
#   MIDSCENE_MODEL_FAMILY=codely-vl
#
# 不要设 MIDSCENE_MODEL_REASONING_ENABLED=false：Codely 会把思考文本拼进正文，
# 反而污染 Midscene 的 JSON 解析。
# 会话复用阈值可选，默认 16（同一次用例执行内最多复用 16 轮对话后重建会话）：
#   CODELY_SESSION_MAX_PROMPTS=16
#
# 其他模型的配置方式见 https://midscenejs.com/model-common-config.html
# 配置完成后验证连通性（不连设备、不调模型）：
#   pnpm exec midscene-test model verify

MIDSCENE_MODEL_BASE_URL=
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_FAMILY=

# Optional: choose a device from adb devices.
ANDROID_DEVICE_ID=